[init]
  defaultBranch = main

[pull]
  rebase = false

[core]
  editor = code --wait

[push]
  autoSetupRemote = true

[alias]
  in = init
  br = branch
  sw = switch
  cm = commit -m
  ps = push
  pl = pull
  cl = clone
  st = status
  ut = rm --cached
  rs = reset --soft HEAD~1
  rts = restore --staged
  rt = restore

[include]
  path = ~/.gitconfig.local